# Required by backend
TOKEN=replace-me-with-a-long-random-string

OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma4:e2b
HERMES_URL=
HERMES_MODEL=
HERMES_API_KEY=
# Jev, the AI Categorization button on the Activity page
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# Bank connections: sandbox uses test accounts; production needs Plaid approval.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate once: openssl rand -hex 32. Keep stable and back it up securely.
PLAID_TOKEN_ENCRYPTION_KEY=
# Public URL routed through the frontend /api proxy (no app auth token needed).
PLAID_WEBHOOK_URL=https://your-domain.example/api/bank-connections/webhook
# Register this URL in the Plaid dashboard; do not include a hash or query.
PLAID_REDIRECT_URI=https://your-domain.example/
# Optional paid Plaid Transactions Refresh product; requires provider access.
PLAID_ENABLE_REFRESH=false
