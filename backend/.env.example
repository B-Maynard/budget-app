# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=budget_app
PORT=3000
TOKEN=replace-me-with-a-long-random-string

# Optional categorization
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0

# Bank connections
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Generate once with: openssl rand -hex 32
PLAID_TOKEN_ENCRYPTION_KEY=
# Use a public HTTPS tunnel to localhost:3000 for local webhook testing.
PLAID_WEBHOOK_URL=
# Register in the Plaid dashboard. No hash or query parameters.
PLAID_REDIRECT_URI=http://localhost:4200/
PLAID_ENABLE_REFRESH=false
